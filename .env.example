# Connection string de Neon (Postgres). Consíguela en el dashboard de Neon,
# en Connection Details. Usá el "pooled connection string".
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Secreto de Auth.js. Generalo con: npx auth secret
# (o `openssl rand -base64 33`)
AUTH_SECRET=""

# Necesario si desplegás en un servidor propio (Docker, VPS) detrás de un
# proxy/dominio propio en vez de Vercel. Sin esto, Auth.js rechaza el host
# con el error "UntrustedHost".
AUTH_TRUST_HOST="true"

# Datos del primer usuario administrador, usados por `npm run seed`.
ADMIN_NOMBRE="Nombre Apellido"
ADMIN_EMAIL="admin@ejemplo.com"
ADMIN_PASSWORD="cambiar-esta-contraseña"
